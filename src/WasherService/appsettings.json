{
  "ConnectionStrings": {
    "WasherDB": "Server=localhost;Database=WasherDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "GreenCarWash",
    "Audience": "GreenCarWash",
    "Key": "dev-only-greencarwash-jwt-signing-key"
  },
  "InternalApi": {
    "Key": "dev-only-internal-key"
  },
  "Queue": {
    "DefaultStrategy": "Fifo",
    "OfferLeaseSeconds": 120
  },
  "ServiceUrls": {
    "Auth": "http://localhost:7000",
    "Customer": "http://localhost:7001",
    "Catalog": "http://localhost:7003",
    "Booking": "http://localhost:7004",
    "Payment": "http://localhost:7005",
    "Notification": "http://localhost:7006"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}

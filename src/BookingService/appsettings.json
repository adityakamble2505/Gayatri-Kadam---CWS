{
  "ConnectionStrings": {
    "BookingDB": "Server=localhost;Database=BookingDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "GreenCarWash",
    "Audience": "GreenCarWash",
    "Key": "dev-only-greencarwash-jwt-signing-key"
  },
  "InternalApi": {
    "Key": "dev-only-internal-key"
  },
  "ServiceUrls": {
    "Auth": "http://localhost:7000",
    "Customer": "http://localhost:7001",
    "Washer": "http://localhost:7002",
    "Catalog": "http://localhost:7003",
    "Payment": "http://localhost:7005",
    "Notification": "http://localhost:7006"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Dispatch": {
    "ImmediateStrategy": "Nearest",
    "ScheduledStrategy": "TopRated",
    "RetryDelaySeconds": 10,
    "MaxAttempts": 5,
    "OfferSeconds": 60,
    "ScheduledWindowMinutes": 30
  },
  "AllowedHosts": "*"
}

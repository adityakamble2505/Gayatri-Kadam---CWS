{
  "ConnectionStrings": {
    "PaymentDB": "Server=localhost;Database=PaymentDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "GreenCarWash",
    "Audience": "GreenCarWash",
    "Key": "dev-only-greencarwash-jwt-signing-key"
  },
  "InternalApi": {
    "Key": "dev-only-internal-key"
  },
  "ServiceUrls": {
    "Auth": "http://localhost:7000",
    "Customer": "http://localhost:7001",
    "Washer": "http://localhost:7002",
    "Catalog": "http://localhost:7003",
    "Booking": "http://localhost:7004",
    "Notification": "http://localhost:7006"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Payments": {
    "PayableStatuses": [ "Pending", "Scheduled", "Accepted", "InProgress", "Completed" ],
    "GatewayMinDelayMs": 30,
    "GatewayMaxDelayMs": 120,
    "PendingTimeoutMinutes": 5
  },
  "AllowedHosts": "*"
}
